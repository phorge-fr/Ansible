// Alloy on the storage node: host and container metrics, container and journal logs.
// Same endpoints, CA and basic auth pattern as the k0s clusters (FrontPlane, base/controllers/alloy).
// The credentials come from /etc/alloy-secrets.env. Prometheus and Loki have their own password for this user.

prometheus.remote_write "core" {
  endpoint {
    url = "https://prometheus.core.phorge/api/v1/write"

    basic_auth {
      username = sys.env("ALLOY_BASIC_AUTH_USERNAME")
      password = sys.env("ALLOY_PROMETHEUS_BASIC_AUTH_PASSWORD")
    }

    tls_config {
      ca_file = "/etc/alloy-ca/ca.crt"
    }
  }

  external_labels = {
    cluster = "stor",
  }
}

loki.write "core" {
  endpoint {
    url = "https://loki.core.phorge/loki/api/v1/push"

    basic_auth {
      username = sys.env("ALLOY_BASIC_AUTH_USERNAME")
      password = sys.env("ALLOY_LOKI_BASIC_AUTH_PASSWORD")
    }

    tls_config {
      ca_file = "/etc/alloy-ca/ca.crt"
    }
  }

  external_labels = {
    cluster = "stor",
  }
}

// Host metrics

// The nvme collector fails on this kernel (unreadable /sys/class/nvme/*/nuse) and logs an error at every scrape.
//
// The systemd collector is what lets NodeSystemdServiceFailed and
// NodeSystemdServiceCrashlooping (kube-prometheus-stack, on core) fire for this
// node at all: with no node_systemd_* series for cluster="stor", a failed unit
// is invisible to monitoring. Alloy runs as root here (alloy_systemd_override in
// group_vars/storage.yml), so it can reach the system bus.
//
// unit_include keeps the series count to the units whose failure actually
// matters on a storage node - the NFS stack, the array monitor, Docker (rustfs),
// Alloy itself, SSH and time sync - instead of every unit on the host.
prometheus.exporter.unix "node" {
  disable_collectors = ["nvme"]
  enable_collectors  = ["systemd"]

  systemd {
    unit_include = "^(alloy|docker|mdmonitor|nfs-server|nfs-mountd|nfs-idmapd|nfsdcld|rpcbind|rpc-statd|ssh|systemd-timesyncd)\\.service$"
  }
}

discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets

  rule {
    target_label = "job"
    replacement  = "node-exporter"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "node" {
  job_name   = "node-exporter"
  targets    = discovery.relabel.node.output
  forward_to = [prometheus.remote_write.core.receiver]
}

// Container metrics

prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
  docker_only = true
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.docker.targets

  rule {
    target_label = "job"
    replacement  = "cadvisor"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "cadvisor" {
  job_name   = "cadvisor"
  targets    = discovery.relabel.cadvisor.output
  forward_to = [prometheus.remote_write.core.receiver]
}

// RustFS metrics (OTLP push)

// RustFS exposes no Prometheus endpoint - checked on the running binary, whose
// only observability option is --obs-endpoint, "Root OTLP endpoint for traces,
// metrics, and logs". So nothing can scrape it: Alloy has to receive instead,
// which is what an OTel collector distribution is for.
//
// Bound to the gateway of the rustfs compose network rather than 0.0.0.0, so
// the receiver is reachable from that container and from nothing else. The host
// firewall allows this port from that subnet only (host_vars/stor-rpi5-01).
otelcol.receiver.otlp "rustfs" {
  http {
    endpoint = "172.18.0.1:4318"
  }

  output {
    metrics = [otelcol.processor.batch.rustfs.input]
  }
}

otelcol.processor.batch "rustfs" {
  output {
    metrics = [otelcol.exporter.prometheus.rustfs.input]
  }
}

otelcol.exporter.prometheus "rustfs" {
  forward_to = [prometheus.relabel.rustfs.receiver]
}

// The OTLP resource attributes decide the labels, and RustFS sets its own, so
// job and instance are forced here to match every other series of this node.
prometheus.relabel "rustfs" {
  forward_to = [prometheus.remote_write.core.receiver]

  rule {
    target_label = "job"
    replacement  = "rustfs"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

// Container logs

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.container_logs.rules
  labels        = {"job" = "docker"}
  forward_to    = [loki.write.core.receiver]
}

// Host logs (journal)

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "instance"
  }
}

loki.source.journal "host" {
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.journal.receiver]
}

// loki.source.journal sets job to its component ID and ignores it in labels, so set it here.
loki.process "journal" {
  stage.static_labels {
    values = {"job" = "journal"}
  }

  forward_to = [loki.write.core.receiver]
}
