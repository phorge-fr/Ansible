[Unit]
Description=Phorge host firewall (nftables table inet phorge_filter)
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ExecStart=/usr/sbin/nft -f /etc/phorge-firewall.nft
ExecReload=/usr/sbin/nft -f /etc/phorge-firewall.nft
ExecStop=-/usr/sbin/nft delete table inet phorge_filter

[Install]
WantedBy=sysinit.target
